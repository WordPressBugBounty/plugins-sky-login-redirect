{
    "name": "skyminds/sky-login-redirect",
    "type": "wordpress-plugin",
    "description": "WordPress and Woocommerce Login Redirects made easy",
    "version": "4.2.9",
    "license": "SaaS",
    "authors": [
        {
            "name": "Utopique Plugins",
            "email": "support@utopique.net"
        }
    ],
    "require": {
        "composer/installers": "^1.12",
        "freemius/wordpress-sdk": "^2.13",
        "htmlburger/carbon-fields": "^3.6"
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
	"scripts": {
      "test": [
        "@test:php",
        "@test:js"
      ],
      "test:php": "phpunit --configuration phpunit.xml.dist",
      "test:integration": "phpunit --configuration phpunit.integration.xml.dist",
      "test:js": "node --test tests/js/*.test.js",
      "test:all": [
        "@test",
        "@test:integration"
      ],
      "phpcs": "phpcs --standard=phpcs.xml",
      "phpcs:security": "phpcs --standard=WordPress-Extra --extensions=php --sniffs=WordPress.Security.EscapeOutput,WordPress.Security.NonceVerification,WordPress.Security.ValidatedSanitizedInput sky-login-redirect.php includes premium",
		  "phpcbf": "phpcbf --standard=phpcs.xml"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "*",
        "wp-coding-standards/wpcs": "^3.4",
        "squizlabs/php_codesniffer": "^3.13.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "php-stubs/woocommerce-stubs": "^10.9",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    }
}
